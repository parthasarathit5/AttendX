# ==============================================================================
# ATTENDX BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env or configure in Render Dashboard environment variables.
# NEVER commit production credentials or secrets to version control.
# ==============================================================================

# 1. SERVER CONFIGURATION
PORT=8080

# 2. SUPABASE POSTGRESQL CONNECTION (Direct or Session Pooler)
# Direct connection: db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Connection pooler (IPv4): aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-supabase-database-password>
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Connection Pool Tuning
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# 3. SUPABASE AUTH & JWT VERIFICATION
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_JWT_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Optional secret for HS256 validation fallback:
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# 4. SECURITY & CORS SETTINGS
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://attendx.onrender.com

# 5. ENVIRONMENT PROFILE
# In production, set MOCK_TOKENS_ENABLED to false and HIBERNATE_DDL_AUTO to validate
MOCK_TOKENS_ENABLED=false
HIBERNATE_DDL_AUTO=validate
SHOW_SQL=false

